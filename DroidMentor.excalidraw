      "versionNonce": 1523422227,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791493744711,
      "created": 1791493693331,
      "link": null,
      "locked": false,
      "customData": {
        "generationData": {
          "status": "done",
          "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Pill Plis - Modern Health Management</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Inter', sans-serif; }\n        .pill-shape { border-radius: 50px; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-900 min-h-screen flex flex-col\">\n\n    <!-- Navigation -->\n    <header class=\"bg-white border-b border-slate-200 sticky top-0 z-50\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"flex justify-between items-center h-16\">\n                <div class=\"flex items-center space-x-2\">\n                    <div class=\"w-10 h-10 bg-indigo-600 rounded-full flex items-center justify-center\">\n                        <i class=\"fa-solid fa-capsules text-white text-lg\"></i>\n                    </div>\n                    <span class=\"text-2xl font-bold tracking-tight text-indigo-600\">pill plis</span>\n                </div>\n                <nav class=\"hidden md:flex space-x-8 items-center text-sm font-medium text-slate-600\">\n                    <a href=\"#\" class=\"hover:text-indigo-600 transition-colors\">How it Works</a>\n                    <a href=\"#\" class=\"hover:text-indigo-600 transition-colors\">Subscription</a>\n                    <a href=\"#\" class=\"hover:text-indigo-600 transition-colors\">Support</a>\n                    <button class=\"bg-slate-900 text-white px-5 py-2 pill-shape hover:bg-slate-800 transition-all shadow-sm\">Get Started</button>\n                </nav>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"flex-grow\">\n        <!-- Hero Section -->\n        <section class=\"py-20 px-4\">\n            <div class=\"max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center\">\n                <div class=\"space-y-8\">\n                    <div class=\"inline-flex items-center space-x-2 bg-indigo-50 text-indigo-700 px-4 py-1.5 rounded-full text-sm font-medium\">\n                        <span class=\"relative flex h-2 w-2\">\n                            <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75\"></span>\n                            <span class=\"relative inline-flex rounded-full h-2 w-2 bg-indigo-600\"></span>\n                        </span>\n                        <span>Now delivering to your city</span>\n                    </div>\n                    <h1 class=\"text-5xl md:text-7xl font-bold text-slate-900 leading-tight\">\n                        pill <br/> <span class=\"text-indigo-600 italic\">plis</span>\n                    </h1>\n                    <p class=\"text-xl text-slate-600 max-w-md leading-relaxed\">\n                        Never miss a dose again. Personalized pill packaging delivered monthly to your doorstep. Sorted, labeled, and simplified.\n                    </p>\n                    <div class=\"flex flex-col sm:flex-row gap-4\">\n                        <button class=\"px-8 py-4 bg-indigo-600 text-white font-semibold pill-shape hover:bg-indigo-700 hover:shadow-lg transition-all text-lg\">\n                            Transfer Prescription\n                        </button>\n                        <button class=\"px-8 py-4 bg-white border border-slate-200 text-slate-700 font-semibold pill-shape hover:bg-slate-50 transition-all text-lg shadow-sm\">\n                            Learn More\n                        </button>\n                    </div>\n                </div>\n                <div class=\"relative\">\n                    <div class=\"absolute -top-10 -left-10 w-64 h-64 bg-indigo-100 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob\"></div>\n                    <div class=\"absolute -bottom-10 -right-10 w-64 h-64 bg-pink-100 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob animation-delay-2000\"></div>\n                    <img src=\"https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&q=80&w=1200\" alt=\"Healthcare product\" class=\"relative rounded-3xl shadow-2xl border border-white/20\">\n                </div>\n            </div>\n        </section>\n\n        <!-- Features -->\n        <section class=\"bg-white py-24 border-y border-slate-100\">\n            <div class=\"max-w-7xl mx-auto px-4\">\n                <div class=\"text-center mb-16\">\n                    <h2 class=\"text-3xl font-bold text-slate-900\">Health management made human.</h2>\n                </div>\n                <div class=\"grid md:grid-cols-3 gap-12\">\n                    <div class=\"p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-md transition-shadow\">\n                        <div class=\"w-12 h-12 bg-white rounded-xl shadow-sm flex items-center justify-center mb-6 text-indigo-600\">\n                            <i class=\"fa-solid fa-calendar-check text-xl\"></i>\n                        </div>\n                        <h3 class=\"text-xl font-bold mb-3\">Daily Organizers</h3>\n                        <p class=\"text-slate-600\">Individual pouches sorted by date and time so you never have to guess.</p>\n                    </div>\n                    <div class=\"p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-md transition-shadow\">\n                        <div class=\"w-12 h-12 bg-white rounded-xl shadow-sm flex items-center justify-center mb-6 text-indigo-600\">\n                            <i class=\"fa-solid fa-truck-fast text-xl\"></i>\n                        </div>\n                        <h3 class=\"text-xl font-bold mb-3\">Free Delivery</h3>\n                        <p class=\"text-slate-600\">Automatic monthly refills sent straight to your home, no shipping fees.</p>\n                    </div>\n                    <div class=\"p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-md transition-shadow\">\n                        <div class=\"w-12 h-12 bg-white rounded-xl shadow-sm flex items-center justify-center mb-6 text-indigo-600\">\n                            <i class=\"fa-solid fa-user-doctor text-xl\"></i>\n                        </div>\n                        <h3 class=\"text-xl font-bold mb-3\">24/7 Pharmacy Support</h3>\n                        <p class=\"text-slate-600\">Chat with a licensed pharmacist anytime you have questions about your meds.</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- CTA Form -->\n        <section class=\"py-24 px-4 bg-indigo-600\">\n            <div class=\"max-w-4xl mx-auto text-center\">\n                <h2 class=\"text-3xl md:text-4xl font-bold text-white mb-6\">Join the waitlist for <span class=\"italic font-light\">pill plis</span></h2>\n                <p class=\"text-indigo-100 mb-10 text-lg\">Be the first to experience the future of personal pharmacy.</p>\n                <form class=\"flex flex-col sm:flex-row gap-4 max-w-md mx-auto\">\n                    <div class=\"flex-grow\">\n                        <label for=\"email\" class=\"sr-only\">Email address</label>\n                        <input type=\"email\" id=\"email\" placeholder=\"Enter your email\" class=\"w-full px-6 py-4 pill-shape focus:outline-none focus:ring-4 focus:ring-indigo-300 transition-all border-none shadow-lg text-slate-900\" required>\n                    </div>\n                    <button type=\"submit\" class=\"bg-slate-900 text-white px-8 py-4 pill-shape font-bold hover:bg-slate-800 transition-colors shadow-lg\">\n                        Submit\n                    </button>\n                </form>\n            </div>\n        </section>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-slate-900 text-slate-400 py-12 px-4\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center border-b border-slate-800 pb-8 mb-8\">\n            <div class=\"flex items-center space-x-2 mb-6 md:mb-0\">\n                <span class=\"text-2xl font-bold text-white\">pill plis</span>\n            </div>\n            <div class=\"flex space-x-6 text-sm\">\n                <a href=\"#\" class=\"hover:text-white transition-colors\">Privacy</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\">Terms</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\">Cookie Policy</a>\n            </div>\n        </div>\n        <div class=\"max-w-7xl mx-auto text-sm text-center md:text-left\">\n            <p>&copy; 2023 Pill Plis Healthcare. All rights reserved.</p>\n        </div>\n    </footer>\n\n    <style>\n        @keyframes blob {\n            0% { transform: translate(0px, 0px) scale(1); }\n            33% { transform: translate(30px, -50px) scale(1.1); }\n            66% { transform: translate(-20px, 20px) scale(0.9); }\n            100% { transform: translate(0px, 0px) scale(1); }\n        }\n        .animate-blob {\n            animation: blob 7s infinite;\n        }\n        .animation-delay-2000 {\n            animation-delay: 2s;\n        }\n    </style>\n</body>\n</html>"
        }
      }
